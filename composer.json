{
  "name": "lavertia/workspace",
  "description": "Development workspace for the Lavertia component framework.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0 || ^13.0",
    "inertiajs/inertia-laravel": "^3.0",
    "lavertia/support": "^0.1",
    "lavertia/panels": "^0.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": true,
        "versions": {
          "lavertia/support": "0.1.0",
          "lavertia/panels": "0.1.0"
        }
      }
    }
  ],
  "scripts": {
    "test": [
      "php -d zend.assertions=1 -d assert.exception=1 packages/support/tests/smoke.php",
      "php -d zend.assertions=1 -d assert.exception=1 packages/panels/tests/smoke.php",
      "vendor/bin/phpunit -c packages/support/phpunit.xml.dist",
      "vendor/bin/phpunit -c packages/panels/phpunit.xml.dist"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
