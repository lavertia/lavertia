{
  "name": "lavertia/panels",
  "description": "PHP-first freely composable pages with Laravel, Inertia.js and Vue.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0 || ^13.0",
    "inertiajs/inertia-laravel": "^3.0",
    "lavertia/support": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "Lavertia\\Panels\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lavertia\\Panels\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "extra": {
    "laravel": {
      "providers": ["Lavertia\\Panels\\PanelsServiceProvider"]
    }
  }
}
